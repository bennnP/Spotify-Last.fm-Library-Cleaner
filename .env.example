# Copy this file to .env and fill in your real values.
# Get these from https://developer.spotify.com/dashboard -> your app -> Settings

SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Must exactly match the Redirect URI you set in the Spotify dashboard
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# Create an API application at https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here

# Any random string, used to sign the state/cookie during OAuth
SESSION_SECRET=change_this_to_something_random

PORT=3000

# Production hardening
NODE_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:3000
MAX_UPLOAD_MB=250
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20
REQUIRE_HTTPS=false
TRUST_PROXY=false
# Expiration for the signed, in-memory browser session
SESSION_TTL_HOURS=12
